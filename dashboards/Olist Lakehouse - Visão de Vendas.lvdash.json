{
  "datasets": [
    {
      "name": "44f76fae",
      "displayName": "Monthly Revenue by State Summary",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "  c.customer_state,\n",
        "  date_trunc('month', f.order_purchase_timestamp) AS mes,\n",
        "  ROUND(SUM(f.price), 2) AS receita_total\n",
        "FROM\n",
        "  olist_project.gold.fact_orders f\n",
        "    JOIN olist_project.gold.dim_customer c\n",
        "      ON f.customer_id = c.customer_id\n",
        "GROUP BY\n",
        "  c.customer_state,\n",
        "  date_trunc('month', f.order_purchase_timestamp)\n",
        "ORDER BY\n",
        "  mes"
      ]
    },
    {
      "name": "57dfaf08",
      "displayName": "Top Ten Product Categories by Revenue Analysis",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    p.product_category_name_english AS categoria,\n",
        "    ROUND(SUM(f.price), 2) AS receita_total\n",
        "FROM olist_project.gold.fact_orders f\n",
        "JOIN olist_project.gold.dim_product p ON f.product_id = p.product_id\n",
        "WHERE p.product_category_name_english IS NOT NULL\n",
        "GROUP BY p.product_category_name_english\n",
        "ORDER BY receita_total DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "3b74a944",
      "displayName": "Average Ticket Value by State Analysis",
      "queryLines": [
        "-- Gráfico 3 — Ticket médio por estado (barra)\r\n",
        "SELECT\r\n",
        "    c.customer_state,\r\n",
        "    ROUND(SUM(f.price) / COUNT(DISTINCT f.order_id), 2) AS ticket_medio\r\n",
        "FROM olist_project.gold.fact_orders f\r\n",
        "JOIN olist_project.gold.dim_customer c ON f.customer_id = c.customer_id\r\n",
        "GROUP BY c.customer_state\r\n",
        "ORDER BY ticket_medio DESC"
      ],
      "catalog": "olist_project",
      "schema": "bronze"
    },
    {
      "name": "f5397af8",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "-- Gráfico 3 — Ticket médio por estado (barra)\n",
        "SELECT\n",
        "    c.customer_state,\n",
        "    ROUND(SUM(f.price) / COUNT(DISTINCT f.order_id), 2) AS ticket_medio\n",
        "FROM olist_project.gold.fact_orders f\n",
        "JOIN olist_project.gold.dim_customer c ON f.customer_id = c.customer_id\n",
        "GROUP BY c.customer_state\n",
        "ORDER BY ticket_medio DESC"
      ]
    },
    {
      "name": "7ccc4abe",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT\n",
        "    c.customer_state,\n",
        "    date_trunc('month', f.order_purchase_timestamp) AS mes,\n",
        "    ROUND(SUM(f.price), 2) AS receita_total\n",
        "FROM olist_project.gold.fact_orders f\n",
        "JOIN olist_project.gold.dim_customer c ON f.customer_id = c.customer_id\n",
        "GROUP BY c.customer_state, date_trunc('month', f.order_purchase_timestamp)\n",
        "ORDER BY mes"
      ]
    }
  ],
